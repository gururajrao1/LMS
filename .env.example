ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
PHARMALEARN_RUN_BUDGET_USD=8
PHARMALEARN_MAX_INPUT_TOKENS=190000
PHARMALEARN_PPT_PROVIDER=local
PHARMALEARN_PPT_STAGE_BUDGET_USD=1.50
PHARMALEARN_PPT_MAX_TURNS=2
PHARMALEARN_DATA_DIR=.pharmalearn
NEXT_PUBLIC_API_URL=http://localhost:8000

# Demo: replay this finished run stage by stage instead of regenerating it.
# Unset for a genuine live research run.
PHARMALEARN_REPLAY_SOURCE=ibrance-cycle-safety-refresher
# Seconds between replayed stages.
PHARMALEARN_STAGE_DELAY=0.6
# Demo: let the final assessment fill unanswered questions with the correct answer.
PHARMALEARN_DEMO_FILL=1
# Remote-first evidence: where fetched documents may be contacted from.
PHARMALEARN_CONTACT_EMAIL=pharmalearn@example.com
# Optional API credentials for the evidence fetch tiers (all tiers degrade
# gracefully without them; abstract-only is always free).
NCBI_API_KEY=
UNPAYWALL_EMAIL=
# Verify unheld citations against live bytes during a check (default off: the
# checker stays cheap with no model, no API key, no network).
PHARMALEARN_LIVE_VERIFY=0
# Snapshot only the checkable SPL XML + version history, not ZIP/PDF/images.
PHARMALEARN_NO_BLOBS=0
